                "ORDER_QUEUE_PORT": {
                  "value": "[format('{0}', reference('rabbitmq').properties.port)]"
                },
                "ORDER_QUEUE_USERNAME": {
                  "value": "[reference('rabbitmq').properties.username]"
                }
              },
              "ports": {
                "web": {
                  "containerPort": 3000
                }
              },
              "livenessProbe": {
                "httpGet": {
                  "path": "/health",
                  "port": 3000
                },
                "initialDelaySeconds": 3,
                "periodSeconds": 3,
                "failureThreshold": 5
              },
              "readinessProbe": {
                "httpGet": {
                  "path": "/health",
