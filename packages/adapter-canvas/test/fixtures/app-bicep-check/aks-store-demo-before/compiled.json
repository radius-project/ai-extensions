    "makelineServiceContainer": {
      "import": "radius",
      "type": "Radius.Compute/containers@2025-08-01-preview",
      "properties": {
        "name": "makeline",
        "properties": {
          "environment": "[parameters('environment')]",
          "application": "[reference('aksStoreDemoApp').id]",
          "codeReference": "src/makeline-service/main.go#L88",
          "containers": {
            "service": {
              "image": "[reference('makelineServiceImage').properties.imageReference]",
              "env": {
                "ORDER_DB_COLLECTION_NAME": {
                  "value": "orders"
                },
                "ORDER_DB_NAME": {
                  "value": "orderdb"
                },
                "ORDER_DB_URI": {
                  "valueFrom": {
                    "secretKeyRef": {
                      "secretName": "[reference('mongoDb').properties.secrets.name]",
                      "key": "connectionString"
                    }
                  }
                },
                "ORDER_QUEUE_NAME": {
                  "value": "orders"
                },
                "ORDER_QUEUE_PASSWORD": {
                  "valueFrom": {
                    "secretKeyRef": {
                      "secretName": "[reference('rabbitmqCredentials').name]",
                      "key": "password"
                    }
                  }
                },
                "ORDER_QUEUE_URI": {
                  "value": "[format('amqp://{0}:{1}', reference('rabbitmqBroker').properties.host, reference('rabbitmqBroker').properties.port)]"
                },
                "ORDER_QUEUE_USERNAME": {
                  "value": "username"
                }
              },
              "ports": {
                "web": {
                  "containerPort": 3001
                }
              }
            }
          }
        }
