{
  "name": "@radius-project/canvas",
  "version": "0.1.0",
  "private": true,
  "description": "Copilot canvas adapter for the Radius Canvas product. Builds to the single runtime-loadable extension.mjs that the canvas loader runs.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "build:install": "node build.mjs --install",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "watch": "node build.mjs --watch",
    "watch:dev": "node build.mjs --watch --install",
    "lint": "eslint \"src/**/*.ts\" build.mjs"
  },
  "dependencies": {
    "@radius-project/core": "workspace:*",
    "@radius-project/shared": "workspace:*"
  },
  "devDependencies": {
    "@github/copilot-sdk": "1.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.1",
    "vitest": "^4.1.10"
  }
}
