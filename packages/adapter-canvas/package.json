{
  "name": "@radius-project/adapter-canvas",
  "version": "0.1.0",
  "private": true,
  "description": "Copilot canvas adapter for the Radius Canvas product. Builds to the single runtime-loadable extension.mjs that the canvas loader runs.",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "node build.mjs",
    "build:install": "node build.mjs --install",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:integration:windows-process": "vitest run src/gh.windows.test.ts",
    "test:integration:runtime": "vitest run test/integration/runtime",
    "test:integration:http": "vitest run test/integration/http",
    "test:integration:artifact": "vitest run --config vitest.artifact.config.ts",
    "watch": "node build.mjs --watch",
    "demo": "node dev/run-demo.mjs",
    "demo:check": "node dev/run-demo.mjs --build-only",
    "watch:dev": "node build.mjs --watch --install",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.{ts,mjs}\" vitest.config.ts vitest.artifact.config.ts build.mjs"
  },
  "dependencies": {
    "@radius-project/core": "workspace:*",
    "@radius-project/adapter-shared": "workspace:*"
  },
  "devDependencies": {
    "@github/copilot-sdk": "catalog:",
    "esbuild": "^0.28.2",
    "vitest": "catalog:"
  }
}
