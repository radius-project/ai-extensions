exports[`Azure setup ordered provider transcript > preserves commands, journal saves, legacy narration, and durable evidence for every Azure mutation kind > ordered external and durable effects 1`] = `
[
  [
    "github",
    "/repos/owner/repo/environments/dev/variables/AZURE_CLIENT_ID",
  ],
  [
    "step",
    "Looking up existing App Registration: radius-deploy-owner-repo...",
  ],
  [
    "az",
    [
      "ad",
      "app",
      "list",
      "--filter",
      "displayName eq 'radius-deploy-owner-repo'",
      "--query",
      "[].{appId:appId,id:id,displayName:displayName,createdDateTime:createdDateTime,tags:tags}",
      "-o",
      "json",
    ],
  ],
  [
    "az",
    [
      "ad",
      "signed-in-user",
      "show",
      "--query",
      "id",
      "-o",
      "tsv",
    ],
  ],
  [
    "step",
    "Creating Entra app registration: radius-deploy-owner-repo...",
  ],
  [
    "stop",
    "before-app-registration-create",
  ],
  [
    "save",
    "azure_application.create",
    "prepared",
    null,
  ],
  [
    "az",
    [
      "ad",
      "app",
      "create",
      "--display-name",
      "radius-deploy-owner-repo",
      "--query",
      "appId",
      "-o",
      "tsv",
    ],
  ],
  [
    "save",
    "azure_application.create",
    "confirmed",
    "The provider acknowledged the mutation.",
  ],
  [
    "step",
    "✅ Entra app registration created: 33333333-3333-3333-3333-333333333333",
  ],
  [
    "application",
    {
      "appId": "33333333-3333-3333-3333-333333333333",
      "displayName": "radius-deploy-owner-repo",
      "origin": "this_operation",
      "serviceManagementReference": null,
      "state": "created",
    },
  ],
  [
    "checkpoint",
    "after-app-registration-create",
  ],
  [
    "save",
    "azure_application.create",
    "confirmed",
    "The provider acknowledged the mutation.",
  ],
  [
    "step",
    "Assigning the Azure CLI identity as an owner of the new App Registration...",
  ],
  [
    "stop",
    "before-app-registration-owner-add",
  ],
  [
    "save",
    "azure_app_owner.add",
    "prepared",
    null,
  ],
  [
    "az",
    [
      "ad",
      "app",
      "owner",
      "add",
      "--id",
      "33333333-3333-3333-3333-333333333333",
      "--owner-object-id",
      "44444444-4444-4444-4444-444444444444",
    ],
  ],
  [
    "save",
    "azure_app_owner.add",
    "confirmed",
    "Entra reported the Azure CLI identity was already an owner, so this operation added nothing.",
  ],
  [
    "checkpoint",
    "after-app-registration-owner-add",
  ],
  [
    "save",
    "azure_app_owner.add",
    "confirmed",
    "Entra reported the Azure CLI identity was already an owner, so this operation added nothing.",
  ],
  [
    "step",
    "Verifying the Azure CLI identity owns the new App Registration...",
  ],
  [
    "az",
    [
      "ad",
      "app",
      "owner",
      "list",
      "--id",
      "33333333-3333-3333-3333-333333333333",
      "--query",
      "[].id",
      "-o",
      "tsv",
    ],
  ],
  [
    "step",
    "✅ Azure CLI identity verified as App Registration owner",
  ],
  [
    "checkpoint",
    "after-app-registration-owner-verify",
  ],
  [
    "save",
    "azure_app_owner.add",
    "confirmed",
    "Entra reported the Azure CLI identity was already an owner, so this operation added nothing.",
  ],
  [
    "step",
    "Applying Radius provenance tags to the new App Registration...",
  ],
  [
    "stop",
    "before-app-registration-tag-update",
  ],
  [
    "save",
    "azure_app_tags.patch",
    "prepared",
    null,
  ],
  [
    "az",
    [
      "rest",
      "--method",
      "PATCH",
      "--url",
      "https://graph.microsoft.com/v1.0/applications(appId='33333333-3333-3333-3333-333333333333')",
      "--body",
      "{"tags":["radius-managed","radius-repo:owner/repo","radius-environment:dev","radius-operation:setup-golden"]}",
    ],
  ],
  [
    "save",
    "azure_app_tags.patch",
    "confirmed",
    "The provider acknowledged the mutation.",
  ],
  [
    "checkpoint",
    "after-app-registration-tag-update",
  ],
  [
    "save",
    "azure_app_tags.patch",
    "confirmed",
    "The provider acknowledged the mutation.",
  ],
  [
    "step",
    "Verifying Radius provenance tags...",
  ],
  [
    "az",
    [
      "ad",
      "app",
      "show",
      "--id",
      "33333333-3333-3333-3333-333333333333",
      "--query",
      "tags",
      "-o",
      "json",
    ],
  ],
  [
    "step",
    "✅ Radius provenance tags verified",
  ],
  [
    "checkpoint",
    "after-app-registration-tag-verify",
  ],
  [
    "save",
    "azure_app_tags.patch",
    "confirmed",
    "The provider acknowledged the mutation.",
  ],
  [
    "step",
    "Creating Service Principal...",
  ],
  [
    "az",
    [
      "ad",
      "sp",
      "show",
      "--id",
      "33333333-3333-3333-3333-333333333333",
      "--query",
      "id",
      "-o",
      "tsv",
    ],
  ],
  [
    "stop",
    "before-service-principal-create",
  ],
  [
    "save",
    "azure_service_principal.create",
    "prepared",
    null,
  ],
  [
    "az",
    [
      "ad",
      "sp",
      "create",
      "--id",
      "33333333-3333-3333-3333-333333333333",
    ],
  ],
  [
    "save",
    "azure_service_principal.create",
    "confirmed",
    "The provider acknowledged the mutation.",
  ],
  [
    "step",
    "✅ Service Principal ready",
  ],
  [
    "principal",
    {
      "appId": "33333333-3333-3333-3333-333333333333",
      "objectId": "principal-object",
      "origin": "this_operation",
      "state": "created",
    },
  ],
  [
    "checkpoint",
    "after-service-principal",
  ],
  [
    "save",
    "azure_service_principal.create",
    "confirmed",
    "The provider acknowledged the mutation.",
  ],
  [
    "lock",
  ],
  [
    "az",
    [
      "ad",
      "app",
      "show",
      "--id",
      "33333333-3333-3333-3333-333333333333",
      "--query",
      "id",
      "-o",
      "tsv",
    ],
  ],
  [
    "az",
    [
      "ad",
      "app",
      "federated-credential",
      "list",
      "--id",
      "33333333-3333-3333-3333-333333333333",
      "--query",
      "[].{id:id,name:name,subject:subject,issuer:issuer,audiences:audiences,claimsMatchingExpression:claimsMatchingExpression}",
      "-o",
      "json",
    ],
  ],
  [
    "step",
    "Creating federated credential "dev"...",
  ],
  [
    "stop",
    "before-federated-credential-create:dev",
  ],
  [
    "file",
    "credential.json",
    {
      "audiences": [
        "api://AzureADTokenExchange",
      ],
      "description": "Created by Radius operation setup-golden",
      "issuer": "https://token.actions.githubusercontent.com",
      "name": "dev",
      "subject": "repo:owner/repo:environment:dev",
    },
