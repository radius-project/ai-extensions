{
  "name": "ai-extensions",
  "private": true,
  "type": "module",
  "description": "Deploy with Radius - Copilot canvas extension",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm --filter @radius-project/adapter-canvas run build",
    "watch": "pnpm --filter @radius-project/adapter-canvas run watch",
    "build:canvas": "pnpm --filter @radius-project/adapter-canvas run build",
    "watch:canvas": "pnpm --filter @radius-project/adapter-canvas run watch",
    "build:install": "pnpm --filter @radius-project/adapter-canvas run build:install",
    "watch:dev": "pnpm --filter @radius-project/adapter-canvas run watch:dev",
    "typecheck": "tsc -p tsconfig.test.json && pnpm -r run --if-present typecheck",
    "test": "vitest run",
    "test:integration:windows-process": "pnpm --filter @radius-project/adapter-canvas run test:integration:windows-process",
    "test:integration:runtime": "pnpm --filter @radius-project/adapter-canvas run test:integration:runtime",
    "test:integration:http": "pnpm --filter @radius-project/adapter-canvas run test:integration:http",
    "test:integration:artifact": "pnpm --filter @radius-project/adapter-canvas run test:integration:artifact",
    "test:component": "pnpm --filter @radius-project/adapter-canvas run test:component",
    "test:chromium": "playwright test --config packages/adapter-canvas/playwright.config.ts",
    "test:visual": "playwright test --config packages/adapter-canvas/playwright.visual.config.ts",
    "test:reliability:node": "pnpm --filter @radius-project/adapter-canvas run test:reliability:node",
    "test:reliability:chromium": "playwright test --config packages/adapter-canvas/playwright.reliability.config.ts",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint eslint.config.mjs \"packages/**/*.{ts,mjs}\" \"plugins/radius/skills/**/*.mjs\" \"scripts/**/*.mjs\" vitest.config.ts",
    "format": "prettier --config .github/linters/.prettierrc.yml --write eslint.config.mjs \"packages/**/*.{ts,mjs}\" \"plugins/radius/skills/**/*.mjs\" \"scripts/**/*.mjs\" vitest.config.ts",
    "format:check": "prettier --config .github/linters/.prettierrc.yml --check eslint.config.mjs \"packages/**/*.{ts,mjs}\" \"plugins/radius/skills/**/*.mjs\" \"scripts/**/*.mjs\" vitest.config.ts",
    "lint:md": "markdownlint-cli2 --config ./.github/linters/.markdownlint-cli2.yaml \"**/*.md\"",
    "lint:md:fix": "markdownlint-cli2 --config ./.github/linters/.markdownlint-cli2.yaml --fix \"**/*.md\"",
    "changeset": "changeset",
    "version": "changeset version && pnpm run version:sync",
    "version:sync": "node scripts/version.mjs --sync",
    "version:check": "node scripts/version.mjs --check",
    "demo:progress": "node packages/adapter-canvas/dev/run-demo.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@babel/core": "^8.0.1",
    "@babel/eslint-parser": "^8.0.1",
    "@babel/plugin-syntax-typescript": "^8.0.3",
    "@changesets/changelog-github": "1.0.0-next.9",
    "@changesets/cli": "3.0.0-next.11",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "^10.8.1",
    "globals": "^17.8.0",
    "markdown-table-formatter": "1.7.0",
    "markdownlint-cli2": "0.23.2",
    "prettier": "^3.9.6",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
